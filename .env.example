# ==============================================================================
# CARMENIBANEZ.CL - CONFIGURACIÓN DE VARIABLES DE ENTORNO (SDD & HEADLESS CMS)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CONEXIÓN A SUPABASE (POSTGRESQL & STORAGE)
# ------------------------------------------------------------------------------
# URL del proyecto Supabase (Project ID: zflljndvanqcnfcpciqb)
NEXT_PUBLIC_SUPABASE_URL=https://zflljndvanqcnfcpciqb.supabase.co

# Clave pública anónima (Safe for client-side / SSR - sujeto a RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clave Service Role (SECRETO - Solo para Antigravity Backend / CMS / Migraciones / Admin)
# ADVERTENCIA: Esta clave bypassea Row Level Security (RLS). NUNCA exponer en cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Nombre del Bucket de Storage en Supabase para portadas de libros
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=book-covers

# ------------------------------------------------------------------------------
# 2. ENTORNO Y DOMINIOS DINÁMICOS (VERCEL WILDCARD DNS)
# ------------------------------------------------------------------------------
# Dominio raíz para la lógica de subdominios en middleware
# En desarrollo: localhost:3000
# En producción: carmenibanez.cl
NEXT_PUBLIC_ROOT_DOMAIN=carmenibanez.cl

# Entorno de ejecución (development | staging | production)
NODE_ENV=development

# ------------------------------------------------------------------------------
# 3. CORREO TRANSACCIONAL (FORMULARIO DE CONTACTO PÚBLICO)
# ------------------------------------------------------------------------------
# Clave API del proveedor Resend (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Dirección destinataria donde se reciben las consultas de la web
CONTACT_TO_EMAIL=contacto@carmenibanez.cl

# Dirección remitente verificada en el proveedor de correo (dominio autenticado)
CONTACT_FROM_EMAIL="Carmen Ibáñez <contacto@carmenibanez.cl>"
